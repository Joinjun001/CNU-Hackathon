# ==============================================================================
# Word402 AI Agent Client Configuration Example (Base Sepolia Live Testnet)
# ==============================================================================

# 1. 타깃 엔드포인트
WORDPRESS_URL=http://localhost:8080/wp-json/word402/v1/posts/1

# 2. Base Sepolia 온체인 RPC & 컨트랙트
BASE_SEPOLIA_RPC=https://sepolia.base.org
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# 3. 에이전트 구매자 지갑 개인키 (0x 포함 66자리 Hex Private Key)
# ※ Base Sepolia ETH(가스비용) 및 Testnet USDC(결제용) 잔액이 사전에 충전되어 있어야 합니다.
AGENT_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. 시뮬레이션 모드 여부 (false 설정 시 실제 온체인 트랜잭션 전송)
SIMULATE=false

